[
  {
    "doctype": "Print Format",
    "name": "POS RECEIPT",
    "doc_type": "POS Invoice",
    "standard": "No",
    "custom_format": 1,
    "print_format_type": "Jinja",
    "print_format_for": "DocType",
    "module": "Selling",
    "disabled": 0,
    "default_print_language": "en",
    "font_size": 14,
    "page_number": "Hide",
    "pdf_generator": "wkhtmltopdf",
    "print_format_builder": 0,
    "print_format_builder_beta": 0,
    "show_section_headings": 0,
    "line_breaks": 0,
    "margin_top": 2.0,
    "margin_bottom": 2.0,
    "margin_left": 2.0,
    "margin_right": 2.0,
    "html": "\n<style id=\"nozom-pos-final-compact-patch\">\n/* NOZOM POS final compact receipt adjustments */\n\n.nozom-receipt,\n.nozom-pos-receipt,\n.print-format {\n    width: 100% !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding-left: 1mm !important;\n    padding-right: 1mm !important;\n    box-sizing: border-box !important;\n}\n\n.nozom-detail-row,\n.receipt-detail-row,\n.nozom-info-row {\n    margin-top: 0 !important;\n    margin-bottom: 0 !important;\n    padding-top: 0 !important;\n    padding-bottom: 0 !important;\n    min-height: 0 !important;\n    line-height: 1.05 !important;\n}\n\n.nozom-detail-row > *,\n.receipt-detail-row > *,\n.nozom-info-row > * {\n    margin-top: 0 !important;\n    margin-bottom: 0 !important;\n    padding-top: 1px !important;\n    padding-bottom: 1px !important;\n    line-height: 1.05 !important;\n}\n\n/* compact long-text blocks such as Address / Order Note */\n.nozom-full-width-label,\n.nozom-long-label {\n    margin: 1px 0 0 !important;\n    padding: 0 !important;\n    line-height: 1.05 !important;\n}\n\n.nozom-full-width-value,\n.nozom-long-value {\n    margin: 0 0 2px !important;\n    padding: 0 !important;\n    line-height: 1.10 !important;\n}\n\n/* item table */\n.nozom-items-table {\n    width: 100% !important;\n    table-layout: fixed !important;\n    border-collapse: collapse !important;\n}\n\n.nozom-items-table th,\n.nozom-items-table td {\n    padding-top: 2px !important;\n    padding-bottom: 2px !important;\n    line-height: 1.08 !important;\n}\n\n.nozom-items-table th {\n    text-align: center !important;\n}\n\n.nozom-item-col {\n\twidth: 45% !important;\n}\n\n.nozom-price-col {\n\twidth: 18% !important;\n\ttext-align: center !important;\n}\n\n.nozom-qty-col {\n\twidth: 12% !important;\n\ttext-align: center !important;\n}\n\n.nozom-amount-col {\n\twidth: 25% !important;\n\ttext-align: center !important;\n}\n\n/* totals/payment area */\n.nozom-total-row,\n.nozom-payment-row {\n    margin: 0 !important;\n    padding: 1px 0 !important;\n    line-height: 1.08 !important;\n}\n\n.nozom-grand-total,\n.nozom-remaining-emphasis {\n    font-weight: 700 !important;\n    font-size: 15px !important;\n    border-top: 1px solid #000 !important;\n    padding-top: 3px !important;\n    margin-top: 2px !important;\n    margin-bottom: 1px !important;\n}\n</style>\n\n<style>page {\n\t\tsize: 80mm auto;\n\t\tmargin: 2mm 2mm 2mm 2mm;\n\t}\n\n\thtml, body {\n\t\tmargin: 0 !important;\n\t\tpadding: 0 !important;\n\t\twidth: 100% !important;\n\t}\n\n\t.print-format {\n\t\twidth: 100% !important;\n\t\tmax-width: none !important;\n\t\tbox-sizing: border-box !important;\n\t\tmargin: 0 !important;\n\t\tpadding: 1mm !important;\n\t\tfont-family: Arial, \"Noto Sans Arabic\", sans-serif;\n\t}\n\n\t.print-format,\n\t.print-format table,\n\t.print-format tr,\n\t.print-format td,\n\t.print-format th,\n\t.print-format p,\n\t.print-format div {\n\t\tfont-size: 12px;\n\t\tline-height: 1.1;\n\t\tmargin: 0;\n\t\tpadding: 0;\n\t\tcolor: #000;\n\t\tbox-sizing: border-box;\n\t}\n\n\t@media screen {\n\t\t.print-format {\n\t\t\twidth: 76mm !important;\n\t\t\tmax-width: 76mm !important;\n\t\t\tmargin: 0 auto !important;\n\t\t\tpadding: 1mm 1.5mm !important;\n\t\t}\n\t}\n\n\t@media print {\n\t\thtml, body {\n\t\t\tmargin: 0 !important;\n\t\t\tpadding: 0 !important;\n\t\t\twidth: 100% !important;\n\t\t}\n\t\t.print-format {\n\t\t\twidth: 100% !important;\n\t\t\tmax-width: none !important;\n\t\t\tmargin: 0 !important;\n\t\t\tpadding: 0.5mm 1mm !important;\n\t\t}\n\t}\n\n\t.print-heading,\n\t.letter-head {\n\t\tdisplay: none !important;\n\t}\n\n\t.center {\n\t\ttext-align: center;\n\t}\n\n\t.right {\n\t\ttext-align: right;\n\t}\n\n\t.bold {\n\t\tfont-weight: 700;\n\t}\n\n\t.print-logo {\n\t\tmargin: 1px 0 2px 0;\n\t}\n\n\t.print-logo img {\n\t\tdisplay: block;\n\t\tmargin: 0 auto;\n\t\twidth: auto;\n\t\theight: auto;\n\t\tmax-width: 100%;\n\t\tobject-fit: contain;\n\t}\n\n\t.company-name {\n\t\tfont-size: 15px !important;\n\t\tfont-weight: 800;\n\t\tline-height: 1.15;\n\t\tmargin: 0;\n\t}\n\n\t.invoice-title {\n\t\tfont-size: 13px !important;\n\t\tfont-weight: 800;\n\t\tmargin-top: 1px !important;\n\t\tline-height: 1.15;\n\t}\n\n\t.tax-number {\n\t\tfont-size: 11.5px !important;\n\t\tmargin-top: 1px !important;\n\t\tline-height: 1.15;\n\t}\n\n\t.sep {\n\t\tborder: 0;\n\t\tborder-top: 1px dashed #000;\n\t\tmargin: 2px 0;\n\t\theight: 0;\n\t}\n\n\ttable {\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t}\n\n\t.meta-table {\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t\ttable-layout: fixed;\n\t\tmargin: 1px 0;\n\t}\n\n\t.meta-table td {\n\t\tpadding: 1px 0;\n\t\tvertical-align: top;\n\t\tline-height: 1.15;\n\t}\n\n\t.meta-table .col-en {\n\t\twidth: 22%;\n\t\ttext-align: left;\n\t\tdirection: ltr;\n\t\tfont-weight: 600;\n\t\tfont-size: 11.5px;\n\t\twhite-space: nowrap;\n\t}\n\n\t.meta-table .col-val {\n\t\twidth: 56%;\n\t\ttext-align: center;\n\t\tfont-size: 12px;\n\t\tword-break: break-word;\n\t}\n\n\t.meta-table .col-ar {\n\t\twidth: 22%;\n\t\ttext-align: right;\n\t\tdirection: rtl;\n\t\tfont-weight: 600;\n\t\tfont-size: 11.5px;\n\t\twhite-space: nowrap;\n\t}\n\n\t.meta-table .full-address-val {\n\t\ttext-align: center;\n\t\tpadding: 1px 0 1.5px 0;\n\t\tfont-size: 11.5px;\n\t\tline-height: 1.15;\n\t\tword-break: break-word;\n\t\tunicode-bidi: plaintext;\n\t}\n\n\t.items {\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t\ttable-layout: fixed;\n\t\tmargin-top: 1px;\n\t}\n\n\t.items th {\n\t\tfont-size: 11.5px !important;\n\t\tfont-weight: 700;\n\t\tborder-bottom: 1px solid #000;\n\t\tpadding: 2px 1px;\n\t\ttext-align: center;\n\t\tvertical-align: middle;\n\t\tline-height: 1.1;\n\t}\n\n\t.items td {\n\t\tpadding: 2px 1px;\n\t\tvertical-align: top;\n\t\tline-height: 1.1;\n\t}\n\n\t.items tbody tr.item-row + tr.item-row td {\n\t\tborder-top: 1px dotted #bbb;\n\t}\n\n\t.items tbody tr.item-notes-row td {\n\t\tborder-top: 0 !important;\n\t\tpadding-top: 0 !important;\n\t\tpadding-bottom: 1.5px !important;\n\t}\n\n\t.items tbody tr.item-notes-row + tr.item-row td {\n\t\tborder-top: 1px dotted #bbb;\n\t}\n\n\t.item-name {\n\t\tfont-size: 12.5px !important;\n\t}\n\n\t.item-sub {\n\t\tfont-size: 10.5px !important;\n\t\tline-height: 1.1;\n\t}\n\n\t.split-labels {\n\t\tdisplay: table;\n\t\twidth: 100%;\n\t\tfont-weight: 600;\n\t\tfont-size: 11px;\n\t\tline-height: 1.1;\n\t\tmargin-top: 1px;\n\t}\n\n\t.lbl-left {\n\t\tdisplay: table-cell;\n\t\ttext-align: left;\n\t\tdirection: ltr;\n\t\twidth: 50%;\n\t}\n\n\t.lbl-right {\n\t\tdisplay: table-cell;\n\t\ttext-align: right;\n\t\tdirection: rtl;\n\t\twidth: 50%;\n\t}\n\n\t.item-note-text {\n\t\tfont-size: 11px;\n\t\tline-height: 1.15;\n\t\tpadding: 1px 0;\n\t\ttext-align: center;\n\t\tword-break: break-word;\n\t\tunicode-bidi: plaintext;\n\t}\n\n\t.grand-total-row td {\n\t\tfont-size: 15px !important;\n\t\tfont-weight: 800;\n\t\tpadding-top: 2px;\n\t\tpadding-bottom: 2px;\n\t\tborder-top: 2px solid #000;\n\t\tborder-bottom: 1px solid #000;\n\t}\n\n\t.full-block {\n\t\tmargin: 1.5px 0;\n\t}\n\n\t.full-content {\n\t\tfont-size: 11.5px;\n\t\tline-height: 1.15;\n\t\tpadding-top: 1px;\n\t\ttext-align: center;\n\t\tword-break: break-word;\n\t\tunicode-bidi: plaintext;\n\t}\n\n\t.footer {\n\t\tfont-size: 11.5px !important;\n\t\tfont-weight: 700;\n\t\tmargin-top: 2px !important;\n\t\tmargin-bottom: 1px !important;\n\t\tline-height: 1.15;\n\t}\n\n\t.qr {\n\t\ttext-align: center;\n\t\tmargin-top: 1.5px;\n\t}\n\n\t.qr svg {\n\t\twidth: 19mm !important;\n\t\theight: 19mm !important;\n\t}\n\n\t.no-wrap {\n\t\twhite-space: nowrap;\n\t}\n</style>\n\n{% set print_logo = get_pos_profile_print_logo(doc.pos_profile) %}\n{% set print_logo_max_height = get_pos_profile_print_logo_max_height(doc.pos_profile) %}\n{% if print_logo %}\n<div class=\"center print-logo\">\n\t<img src=\"{{ print_logo }}\" alt=\"Logo\" style=\"height: auto; max-height: {{ print_logo_max_height }}; max-width: 100%;\">\n</div>\n{% endif %}\n\n{% set company_tax_id = get_company_tax_id(doc.company) %}\n{% set customer_tax_id = doc.tax_id %}\n{% set recipient = doc.nozom_recipient_name_snapshot %}\n{% set phone = doc.nozom_customer_phone_snapshot or doc.contact_mobile %}\n{% set addr_title = doc.nozom_address_title_snapshot %}\n{% set addr_body = format_address_plain(doc.address_display or doc.shipping_address, \"، \") %}\n\n<div class=\"center\">\n\t<div class=\"company-name\">{{ doc.company }}</div>\n\n\t{% if company_tax_id %}\n\t<div class=\"tax-number\">\n\t\t<b>TRN / الرقم الضريبي:</b> {{ company_tax_id }}\n\t</div>\n\t{% endif %}\n\n\t<div class=\"invoice-title\">TAX INVOICE / فاتورة ضريبية</div>\n</div>\n\n<hr class=\"sep\">\n\n<table class=\"meta-table\">\n\t<colgroup>\n\t\t<col style=\"width: 22%;\">\n\t\t<col style=\"width: 56%;\">\n\t\t<col style=\"width: 22%;\">\n\t</colgroup>\n\t<tr>\n\t\t<td class=\"col-en\">Receipt</td>\n\t\t<td class=\"col-val\">{{ doc.name }}</td>\n\t\t<td class=\"col-ar\">رقم الفاتورة</td>\n\t</tr>\n\t{% if doc.nozom_order_number %}\n\t<tr>\n\t\t<td class=\"col-en\">Order</td>\n\t\t<td class=\"col-val\">{{ doc.nozom_order_number }}</td>\n\t\t<td class=\"col-ar\">رقم الطلب</td>\n\t</tr>\n\t{% endif %}\n\t<tr>\n\t\t<td class=\"col-en\">Date</td>\n\t\t<td class=\"col-val\">{{ doc.get_formatted(\"posting_date\") }} {{ doc.get_formatted(\"posting_time\") }}</td>\n\t\t<td class=\"col-ar\">التاريخ</td>\n\t</tr>\n\t<tr>\n\t\t<td class=\"col-en\">Cashier</td>\n\t\t<td class=\"col-val\">{{ get_cashier_name(doc.owner) }}</td>\n\t\t<td class=\"col-ar\">الكاشير</td>\n\t</tr>\n\t<tr>\n\t\t<td class=\"col-en\">Customer</td>\n\t\t<td class=\"col-val\">{{ doc.customer_name }}</td>\n\t\t<td class=\"col-ar\">العميل</td>\n\t</tr>\n\t{% if customer_tax_id %}\n\t<tr>\n\t\t<td class=\"col-en\">Tax ID</td>\n\t\t<td class=\"col-val\">{{ customer_tax_id }}</td>\n\t\t<td class=\"col-ar\">الرقم الضريبي</td>\n\t</tr>\n\t{% endif %}\n\t{% if recipient %}\n\t<tr>\n\t\t<td class=\"col-en\">Recipient</td>\n\t\t<td class=\"col-val\">{{ recipient }}</td>\n\t\t<td class=\"col-ar\">المستلم</td>\n\t</tr>\n\t{% endif %}\n\t{% if phone %}\n\t<tr>\n\t\t<td class=\"col-en\">Phone</td>\n\t\t<td class=\"col-val\" dir=\"ltr\">{{ phone }}</td>\n\t\t<td class=\"col-ar\">الهاتف</td>\n\t</tr>\n\t{% endif %}\n\t{% if addr_title or addr_body %}\n\t<tr>\n\t\t<td colspan=\"2\" class=\"col-en\">Address</td>\n\t\t<td class=\"col-ar\">العنوان</td>\n\t</tr>\n\t<tr>\n\t\t<td colspan=\"4\" class=\"full-address-val\" dir=\"auto\">\n\t\t\t{% if addr_title %}{{ addr_title }}{% endif %}{% if addr_title and addr_body %} — {% endif %}{% if addr_body %}{{ addr_body }}{% endif %}\n\t\t</td>\n\t</tr>\n\t{% endif %}\n</table>\n\n<hr class=\"sep\">\n\n<table class=\"items\">\n\t<thead>\n\t<tr>\n\t\t<th class=\"nozom-item-col\">\n\t\t\t<div>Item</div>\n\t\t\t<div dir=\"rtl\">الصنف</div>\n\t\t</th>\n\t\t<th class=\"nozom-price-col\">\n\t\t\t<div>Price</div>\n\t\t\t<div dir=\"rtl\">السعر</div>\n\t\t</th>\n\t\t<th class=\"nozom-qty-col\">\n\t\t\t<div>Qty</div>\n\t\t\t<div dir=\"rtl\">الكمية</div>\n\t\t</th>\n\t\t<th class=\"nozom-amount-col\">\n\t\t\t<div>Amount</div>\n\t\t\t<div dir=\"rtl\">المبلغ</div>\n\t\t</th>\n\t</tr>\n</thead>\n\t<tbody>\n\t{% for item in doc.items %}\n\t\t<tr class=\"item-row\">\n\t\t\t<td class=\"nozom-item-col\">\n\t\t\t\t<b class=\"item-name\">{{ item.item_name }}</b>\n\n\t\t\t\t\n\n\t\t\t\t{% if item.discount_percentage %}\n\t\t\t\t<div class=\"item-sub\">\n\t\t\t\t\tDiscount / خصم: {{ item.discount_percentage }}%\n\t\t\t\t</div>\n\t\t\t\t{% elif item.discount_amount %}\n\t\t\t\t<div class=\"item-sub\">\n\t\t\t\t\tDiscount / خصم: {{ item.get_formatted(\"discount_amount\") }}\n\t\t\t\t</div>\n\t\t\t\t{% endif %}\n\t\t\t</td>\n\n\t\t\t\n<td class=\"nozom-price-col\">\n    {{ \"%.2f\"|format(item.rate or item.price_list_rate or 0) }}\n</td>\n<td class=\"nozom-qty-col\">\n\t\t\t\t{{ item.qty }}\n\t\t\t</td>\n\n\t\t\t<td class=\"nozom-amount-col no-wrap\">\n\t\t\t\t{{ item.get_formatted(\"amount\") }}\n\t\t\t</td>\n\t\t</tr>\n\t\t{% if item.notes %}\n\t\t<tr class=\"item-notes-row\">\n\t\t\t<td colspan=\"4\">\n\t\t\t\t<div class=\"item-note-text\" dir=\"auto\">\n\t\t\t\t\t{{ item.notes }}\n\t\t\t\t</div>\n\t\t\t</td>\n\t\t</tr>\n\t\t{% endif %}\n\t{% endfor %}\n\t</tbody>\n</table>\n\n<hr class=\"sep\">\n\n<table class=\"meta-table\">\n\t<colgroup>\n\t\t<col style=\"width: 22%;\">\n\t\t<col style=\"width: 56%;\">\n\t\t<col style=\"width: 22%;\">\n\t</colgroup>\n\t<tr>\n\t\t<td class=\"col-en\">Subtotal</td>\n\t\t<td class=\"col-val\">{{ doc.get_formatted(\"net_total\") }}</td>\n\t\t<td class=\"col-ar\">الإجمالي ق ض</td>\n\t</tr>\n\n\t{% for row in doc.taxes %}\n\t<tr>\n\t\t<td class=\"col-en\">VAT{% if row.rate %} ({{ row.rate }}%){% endif %}</td>\n\t\t<td class=\"col-val\">{{ row.get_formatted(\"tax_amount\", doc) }}</td>\n\t\t<td class=\"col-ar\">الضريبة{% if row.rate %} ({{ row.rate }}%){% endif %}</td>\n\t</tr>\n\t{% endfor %}\n\n\t{% if doc.discount_amount %}\n\t<tr>\n\t\t<td class=\"col-en\">Discount{% if doc.additional_discount_percentage %} ({{ doc.additional_discount_percentage }}%){% endif %}</td>\n\t\t<td class=\"col-val\">- {{ doc.get_formatted(\"discount_amount\") }}</td>\n\t\t<td class=\"col-ar\">الخصم{% if doc.additional_discount_percentage %} ({{ doc.additional_discount_percentage }}%){% endif %}</td>\n\t</tr>\n\t{% endif %}\n\n\t<tr class=\"grand-total-row\">\n\t\t<td class=\"col-en\">TOTAL</td>\n\t\t<td class=\"col-val\">{{ doc.get_formatted(\"grand_total\") }}</td>\n\t\t<td class=\"col-ar\">الإجمالي</td>\n\t</tr>\n\n\t{% set pstatus = payment_status_key(doc) %}\n\t<tr>\n\t\t<td class=\"col-en\">P. Status</td>\n\t\t<td class=\"col-val\"><b>{{ pstatus }}</b></td>\n\t\t<td class=\"col-ar\">حالة الدفع</td>\n\t</tr>\n\n\t{% if doc.paid_amount %}\n\t<tr>\n\t\t<td class=\"col-en\">Paid</td>\n\t\t<td class=\"col-val\">{{ doc.get_formatted(\"paid_amount\") }}</td>\n\t\t<td class=\"col-ar\">المدفوع</td>\n\t</tr>\n\t{% endif %}\n\n\t<tr class=\"grand-total-row remaining-row\">\n\t\t<td class=\"col-en\">Remaining</td>\n\t\t<td class=\"col-val\">{{ get_receipt_remaining_formatted(doc) }}</td>\n\t\t<td class=\"col-ar\">المتبقي</td>\n\t</tr>\n</table>\n\n{% if doc.payments %}\n<hr class=\"sep\">\n\n<table class=\"meta-table\">\n\t<colgroup>\n\t\t<col style=\"width: 22%;\">\n\t\t<col style=\"width: 56%;\">\n\t\t<col style=\"width: 22%;\">\n\t</colgroup>\n\t{% for row in doc.payments %}\n\t\t{% if row.amount and row.amount != 0 %}\n\t\t<tr>\n\t\t\t<td class=\"col-en\">{{ row.mode_of_payment }}</td>\n\t\t\t<td class=\"col-val\">{{ row.get_formatted(\"amount\", doc) }}</td>\n\t\t\t<td class=\"col-ar\"></td>\n\t\t</tr>\n\t\t{% endif %}\n\t{% endfor %}\n\n\t{% if doc.change_amount %}\n\t<tr>\n\t\t<td class=\"col-en\">Change</td>\n\t\t<td class=\"col-val\">{{ doc.get_formatted(\"change_amount\") }}</td>\n\t\t<td class=\"col-ar\">الباقي</td>\n\t</tr>\n\t{% endif %}\n</table>\n{% endif %}\n\n{% if doc.order_notes %}\n<hr class=\"sep\">\n<div class=\"full-block\">\n\t<div class=\"split-labels\">\n\t\t<span class=\"lbl-left\">Order Note</span>\n\t\t<span class=\"lbl-right\">ملاحظة</span>\n\t</div>\n\t<div class=\"full-content\" dir=\"auto\">\n\t\t{{ doc.order_notes }}\n\t</div>\n</div>\n{% endif %}\n\n{% set loc = doc.nozom_delivery_location_link_snapshot %}\n{% if loc and is_safe_location_url(loc) %}\n<hr class=\"sep\">\n<div class=\"full-block\">\n\t<div class=\"split-labels\">\n\t\t<span class=\"lbl-left\">Delivery Location</span>\n\t\t<span class=\"lbl-right\">موقع التوصيل</span>\n\t</div>\n\t<div class=\"qr\">\n\t\t{{ get_delivery_location_qr_svg(loc) }}\n\t</div>\n</div>\n{% endif %}\n\n<hr class=\"sep\">\n\n<div class=\"center footer\">\n\tThank you for your visit / شكراً لزيارتكم\n</div>\n\n<style id=\"nozom-final-meta-tight\">\n.meta-table {\n\tmargin-top: 0 !important;\n\tmargin-bottom: 0 !important;\n}\n\n.meta-table tr {\n\tmargin: 0 !important;\n\tpadding: 0 !important;\n}\n\n.meta-table td {\n\tpadding-top: 0 !important;\n\tpadding-bottom: 0 !important;\n\tline-height: 1.02 !important;\n\theight: auto !important;\n}\n\n.full-address-val {\n\tpadding-top: 0 !important;\n\tpadding-bottom: 1px !important;\n\tline-height: 1.05 !important;\n}\n\n.items th {\n\tpadding-top: 1px !important;\n\tpadding-bottom: 1px !important;\n}\n\n.items td {\n\tpadding-top: 1px !important;\n\tpadding-bottom: 1px !important;\n}\n\n.remaining-row td {\n\tfont-size: 15px !important;\n\tfont-weight: 800 !important;\n\tborder-top: 2px solid #000 !important;\n\tborder-bottom: 1px solid #000 !important;\n\tpadding-top: 2px !important;\n\tpadding-bottom: 2px !important;\n}\n</style>\n\n<style id=\"nozom-spacing-width-tune\">\n/* Wider receipt usage + slightly more breathing room */\n\n@page {\n    size: 80mm auto !important;\n    margin: 1mm 0.8mm !important;\n}\n\nhtml,\nbody {\n    width: 100% !important;\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.print-format,\n.nozom-receipt,\n.nozom-pos-receipt {\n    width: 100% !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding-left: 0.5mm !important;\n    padding-right: 0.5mm !important;\n    box-sizing: border-box !important;\n}\n\n@media screen {\n    .print-format {\n        width: 78.4mm !important;\n        max-width: 78.4mm !important;\n        margin: 0 auto !important;\n        padding-left: 0.5mm !important;\n        padding-right: 0.5mm !important;\n    }\n}\n\n@media print {\n    .print-format {\n        width: 100% !important;\n        max-width: none !important;\n        margin: 0 !important;\n        padding-left: 0.4mm !important;\n        padding-right: 0.4mm !important;\n    }\n}\n\n/* Top receipt details */\n.meta-table td {\n    padding-top: 1px !important;\n    padding-bottom: 1px !important;\n    line-height: 1.10 !important;\n}\n\n/* Address and full-width blocks */\n.full-address-val,\n.full-content,\n.item-note-text {\n    line-height: 1.12 !important;\n    padding-top: 1px !important;\n    padding-bottom: 2px !important;\n}\n\n/* Items table */\n.items {\n    width: 100% !important;\n}\n\n.items th {\n    padding-top: 2px !important;\n    padding-bottom: 2px !important;\n    line-height: 1.12 !important;\n}\n\n.items td {\n    padding-top: 2px !important;\n    padding-bottom: 2px !important;\n    line-height: 1.12 !important;\n}\n\n/* Totals and payment rows */\n.grand-total-row td,\n.remaining-row td {\n    padding-top: 3px !important;\n    padding-bottom: 3px !important;\n    line-height: 1.12 !important;\n}\n\n.sep {\n    margin-top: 3px !important;\n    margin-bottom: 3px !important;\n}\n</style>\n\n\n\n<style id=\"nozom-item-name-center\">\n.nozom-item-col {\n    text-align: center !important;\n}\n\n.item-name {\n    display: block !important;\n    width: 100% !important;\n    text-align: center !important;\n}\n\n.item-note-text {\n    text-align: center !important;\n}\n</style>\n"
