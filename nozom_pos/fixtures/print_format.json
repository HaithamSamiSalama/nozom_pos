    "margin_right": 15.0,
    "html": "\n<!-- ======================== -->\n<!-- نسخة المطبخ / Kitchen Copy -->\n<!-- ======================== -->\n<p class=\"text-center\">\n<b>{{ doc.company }}</b><br>\n<b>Kitchen Order / طلب المطبخ</b>\n</p>\n{% if doc.nozom_order_number %}\n<p class=\"text-center\" style=\"font-size:18px;line-height:1.2;margin:4px 0;\">\n<b>Order No / رقم الطلب:</b><br>\n<span style=\"font-size:28px;font-weight:800;\">{{ doc.nozom_order_number }}</span>\n</p>\n{% endif %}\n<hr>\n<p>\n<b>Order / رقم:</b> {{ doc.name }}<br>\n<b>Customer / العميل:</b> {{ doc.customer_name }}<br>\n<b>Date / التاريخ:</b> {{ doc.get_formatted(\"posting_date\") }}\n</p>\n<hr>\n<table>\n<thead>\n<tr>\n<th>Item / الصنف</th>\n<th>Qty / الكمية</th>\n<th>Notes / ملاحظات</th>\n</tr>\n</thead>\n<tbody>\n{% for item in doc.items %}\n<tr>\n<td>\n<b>{{ item.item_name }}</b>\n{% if item.serial_no %}<br><small>SN: {{ item.serial_no | replace(\"\\n\", \", \") }}</small>{% endif %}\n</td>\n<td class=\"text-right\">{{ item.qty }}</td>\n<td>\n{% if item.notes %}{{ item.notes }}{% endif %}\n</td>\n</tr>\n{% endfor %}\n</tbody>\n</table>\n{% if doc.order_notes %}\n<hr>\n<p><b>Order Note / ملاحظة الطلب:</b><br>{{ doc.order_notes }}</p>\n{% endif %}\n<hr>\n<p class=\"text-center\">Kitchen Copy / نسخة المطبخ</p>\n</div>\n<br><br><br><br><br><br><br><br><br>\n"
  }
