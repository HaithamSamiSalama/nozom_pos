[
  {
    "doctype": "Print Format",
    "name": "POS RECEIPT",
    "doc_type": "POS Invoice",
    "standard": "No",
    "custom_format": 1,
    "print_format_type": "Jinja",
    "print_format_for": "DocType",
    "module": "Selling",
    "disabled": 0,
    "default_print_language": "en",
    "font_size": 14,
    "page_number": "Hide",
    "pdf_generator": "wkhtmltopdf",
    "print_format_builder": 0,
    "print_format_builder_beta": 0,
    "show_section_headings": 0,
    "line_breaks": 0,
    "margin_top": 15.0,
    "margin_bottom": 15.0,
    "margin_left": 15.0,
    "margin_right": 15.0,
    "html": "<style>\n\t.print-format,\n\t.print-format table,\n\t.print-format tr,\n\t.print-format td,\n\t.print-format p,\n\t.print-format div {\n\t\tfont-size: 9px;\n\t\tline-height: 1;\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t}\n\n\t.print-format table {\n\t\tmargin-top: 1px;\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t}\n\n\t.print-format hr {\n\t\tmargin: 2px 0;\n\t\tborder-top: 1px dashed #000;\n\t}\n\n\t@media screen {\n\t\t.print-format {\n\t\t\twidth: 72mm;\n\t\t\tpadding-left: 1mm;\n\t\t\tpadding-right: 1mm;\n\t\t\tpadding-top: 1mm;\n\t\t\tpadding-bottom: 1mm;\n\t\t}\n\t}\n\n\t@media print {\n\t\t.print-format {\n\t\t\tpadding-left: 1mm;\n\t\t\tpadding-right: 1mm;\n\t\t\tpadding-top: 1mm;\n\t\t\tpadding-bottom: 1mm;\n\t\t}\n\t}\n\n\t.text-center { text-align: center; }\n\t.text-right { text-align: right; }\n\t.no-border td { border: none !important; padding: 0; }\n\tsmall { line-height: 1; }\n</style>\n\n{% if letter_head %}\n\t{{ letter_head }}\n{% endif %}\n\n<p class=\"text-center\">\n\t<b>{{ doc.company }}</b><br>\n\t<b>TAX INVOICE / فاتورة ضريبية</b>\n</p>\n\n<hr>\n\n<p>\n\t<b>Receipt / رقم:</b> {{ doc.name }}<br>\n\t<b>Cashier / كاشير:</b> {{ doc.owner }}<br>\n\t<b>Customer / العميل:</b> {{ doc.customer_name }}<br>\n\t<b>Date / التاريخ:</b>\n\t{{ doc.get_formatted(\"posting_date\") }} {{ doc.get_formatted(\"posting_time\") }}\n</p>\n\n<hr>\n\n<table class=\"table table-condensed\">\n\t<thead>\n\t\t<tr>\n\t\t\t<th width=\"50%\">Item / الصنف</th>\n\t\t\t<th width=\"20%\" class=\"text-right\">Qty / الكمية</th>\n\t\t\t<th width=\"30%\" class=\"text-right\">\n\t\t\t\tAmount inc. VAT/المبلغ شامل الضريبة\n\t\t\t</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t{% for item in doc.items %}\n\t<tr>\n\t\t<td>\n\t\t\t<b>{{ item.item_name }}</b>\n\t\t\t{% if item.serial_no %}\n\t\t\t\t<br><small>SN: {{ item.serial_no | replace(\"\\n\", \", \") }}</small>\n\t\t\t{% endif %}\n\t\t</td>\n\t\t<td class=\"text-right\">\n\t\t\t{{ item.qty }}<br>@{{ item.get_formatted(\"rate\") }}\n\t\t</td>\n\t\t<td class=\"text-right\">\n\t\t\t{{ item.get_formatted(\"amount\") }}\n\t\t</td>\n\t</tr>\n\t{% endfor %}\n\t</tbody>\n</table>\n\n<hr>\n\n<table class=\"table table-condensed no-border\">\n\t<tbody>\n\n\t<tr>\n\t\t<td class=\"text-right\" width=\"70%\">\n\t\t\tTotal Before Tax<br>الإجمالي قبل الضريبة\n\t\t</td>\n\t\t<td class=\"text-right\">\n\t\t\t{{ doc.get_formatted(\"net_total\") }}\n\t\t</td>\n\t</tr>\n\n\t{% for row in doc.taxes %}\n\t<tr>\n\t\t<td class=\"text-right\">\n\t\t\t{{ row.description }} (ض.ق.م)\n\t\t</td>\n\t\t<td class=\"text-right\">\n\t\t\t{{ row.get_formatted(\"tax_amount\", doc) }}\n\t\t</td>\n\t</tr>\n\t{% endfor %}\n\n\t<tr>\n\t\t<td class=\"text-right\">\n\t\t\t<b>Total Inc. VAT الإجمالي شامل الضريبة</b>\n\t\t</td>\n\t\t<td class=\"text-right\">\n\t\t\t<b>{{ doc.get_formatted(\"grand_total\") }}</b>\n\t\t</td>\n\t</tr>\n\n\t{% for row in doc.payments %}\n\t{% if row.amount and row.amount != 0 %}\n\t<tr>\n\t\t<td class=\"text-right\">\n\t\t\t{{ row.mode_of_payment }}<br>مدفوع / Paid\n\t\t</td>\n\t\t<td class=\"text-right\">\n\t\t\t{{ row.get_formatted(\"amount\", doc) }}\n\t\t</td>\n\t</tr>\n\t{% endif %}\n\t{% endfor %}\n\n\t{% if doc.change_amount %}\n\t<tr>\n\t\t<td class=\"text-right\">\n\t\t\tChange / الباقي\n\t\t</td>\n\t\t<td class=\"text-right\">\n\t\t\t{{ doc.get_formatted(\"change_amount\") }}\n\t\t</td>\n\t</tr>\n\t{% endif %}\n\n\t</tbody>\n</table>\n\n<hr>\n\n<p class=\"text-center\">\n\tThank you for your visit<br>شكراً لزيارتكم\n</p>\n"
  },
  {
    "doctype": "Print Format",
    "name": "POS Kitchen Print",
    "doc_type": "POS Invoice",
    "standard": "No",
    "custom_format": 1,
    "print_format_type": "Jinja",
    "print_format_for": "DocType",
    "module": "Selling",
    "disabled": 0,
    "default_print_language": "en",
    "font_size": 14,
    "page_number": "Hide",
    "pdf_generator": "wkhtmltopdf",
    "print_format_builder": 0,
    "print_format_builder_beta": 0,
    "show_section_headings": 0,
    "line_breaks": 0,
    "margin_top": 15.0,
    "margin_bottom": 15.0,
    "margin_left": 15.0,
    "margin_right": 15.0,
    "html": "\n<!-- ======================== -->\n<!-- نسخة المطبخ / Kitchen Copy -->\n<!-- ======================== -->\n<p class=\"text-center\">\n<b>{{ doc.company }}</b><br>\n<b>Kitchen Order / طلب المطبخ</b>\n</p>\n<hr>\n<p>\n<b>Order / رقم:</b> {{ doc.name }}<br>\n<b>Customer / العميل:</b> {{ doc.customer_name }}<br>\n<b>Date / التاريخ:</b> {{ doc.get_formatted(\"posting_date\") }}\n</p>\n<hr>\n<table>\n<thead>\n<tr>\n<th>Item / الصنف</th>\n<th>Qty / الكمية</th>\n<th>Notes / ملاحظات</th>\n</tr>\n</thead>\n<tbody>\n{% for item in doc.items %}\n<tr>\n<td>\n<b>{{ item.item_name }}</b>\n{% if item.serial_no %}<br><small>SN: {{ item.serial_no | replace(\"\\n\", \", \") }}</small>{% endif %}\n</td>\n<td class=\"text-right\">{{ item.qty }}</td>\n<td>\n{% if item.notes %}{{ item.notes }}{% endif %}\n</td>\n</tr>\n{% endfor %}\n</tbody>\n</table>\n<hr>\n<p class=\"text-center\">Kitchen Copy / نسخة المطبخ</p>\n</div>\n<br><br><br><br><br><br><br><br><br>\n"
  }
]
